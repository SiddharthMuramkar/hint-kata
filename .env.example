# Copy to .env and fill in. Never commit .env. The owner types secret values.

# OpenRouter API key (secret). Create one with a per-key spend cap.
OPENROUTER_API_KEY=
# Model for the tutor agent, as openrouter:<lab>/<slug>. Default: openrouter:anthropic/claude-haiku-5.5
TUTOR_MODEL=
# Model for the grader agent. Default: openrouter:anthropic/claude-sonnet-5.5
GRADER_MODEL=
# Model for the author script agent. Default: same as GRADER_MODEL
AUTHOR_MODEL=
# Judge model for evals. Default: same as GRADER_MODEL
JUDGE_MODEL=
# Embedding model for docs ingestion, as openrouter:<lab>/<slug>. Default: openrouter:openai/text-embedding-3-small
EMBED_MODEL=
# Vector size of EMBED_MODEL; must equal the chunks.embedding column (vector(1536)). Default: 1536
EMBED_DIMS=
# true or false: route OpenRouter calls to zero-data-retention providers only
OPENROUTER_ZDR=
# App title sent to OpenRouter. Default: hint-kata
OPENROUTER_APP_TITLE=
# Path of the SQLite database. Default: data/hintkata.db
HINTKATA_DB_PATH=
# Neon pooled Postgres URL (secret; host has -pooler). When set, the app uses Postgres instead of SQLite
DATABASE_URL=
# Neon direct (unpooled) Postgres URL (secret), used by scripts/migrate.py and scripts/ingest.py
DATABASE_URL_UNPOOLED=
# Practice repo for GitHub hands-on checks, as owner/name
PRACTICE_REPO=
# Optional Logfire token (secret) for tracing
LOGFIRE_TOKEN=
# Target recall for the review scheduler. Default: 0.9
DESIRED_RETENTION=
# Quiz first-try share needed for mastery. Default: 0.8
MASTERY_QUIZ_THRESHOLD=
# Distinct UTC days each concept must be recalled on. Default: 2
MASTERY_RECALLS_REQUIRED=
