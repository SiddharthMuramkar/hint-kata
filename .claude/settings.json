{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "fable",
  "effortLevel": "high",
  "fallbackModel": ["sonnet"],
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "3",
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "3"
  },
  "extraKnownMarketplaces": {
    "ponytail": { "source": { "source": "github", "repo": "DietrichGebert/ponytail" } },
    "octen": { "source": { "source": "github", "repo": "Octen-Team/octen-mcp" } }
  },
  "enabledPlugins": {
    "hookify@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "pydantic-ai@claude-plugins-official": true,
    "octen@octen": true
  },
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run ty *)",
      "Bash(uv run fastapi *)",
      "Bash(uv run python scripts/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(git worktree *)",
      "Bash(git push -u origin *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh pr merge --auto *)",
      "Bash(gh issue *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh api repos/* --jq *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh api -X PATCH *)",
      "Bash(gh api -X PUT *)",
      "Bash(gh pr merge --admin *)",
      "Bash(gh secret *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(!.env.example)",
      "Edit(.claude/settings*.json)",
      "Edit(.claude/hooks/**)",
      "Edit(.claude/hookify.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/ruff_after_edit.py"],
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
